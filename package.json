{
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cypress": "^16.2.0",
    "cypress-plugin-steps": "1.2.1",
    "cypress-split": "^1.25.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-cypress": "^7.0.2",
    "fkill": "^10.0.3",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "shell-exec": "^1.1.2",
    "ts-node": "^10.9.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "build": "pnpm run --recursive build",
    "lint": "eslint",
    "lint:fix": "pnpm lint --fix",
    "format-check:files": "prettier --check --ignore-unknown",
    "format-check": "pnpm format-check:files .",
    "format:files": "prettier --write --ignore-unknown",
    "format": "pnpm format:files .",
    "type-check": "pnpm run --parallel type-check",
    "test": "pnpm run --recursive test",
    "test:e2e": "cypress run",
    "test:e2e:interactive": "cypress open"
  },
  "packageManager": "pnpm@12.15.0"
}
